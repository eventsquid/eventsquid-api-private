NODE_ENV=development
AWS_REGION=us-west-2
AWS_PROFILE=your-aws-profile-name

# MSSQL_CONNECTION_STRING
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USERNAME=sa
MSSQL_PASSWORD=

# MongoDB connection strings (local dev only — use Secrets Manager in Lambda)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_CONNECTION_STRING=
MONGO_COMMON_CONNECTION_STRING=

# Twilio credentials (local dev only — use Secrets Manager in Lambda)
TWILIO_ACCT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_INBOUND_API_KEY=
TWILIO_STATUS_CALLBACK=
TWILIO_MSG_SERVICE_SID=

# SendGrid credentials (local dev only — use Secrets Manager in Lambda)
SG_API_KEY=
SG_EMAIL_VAL_KEY=
SG_EMAIL_ACTIVITY_KEY=

# Optional overrides — all have sensible defaults; uncomment only when you need to change them
# PORT=3000                                              # Local Express server port (local-server.js)
# TIMEZONEDB_API_KEY=                                    # Falls back to Secrets Manager when running in Lambda
# S3_BASE_URL=https://s3-us-west-2.amazonaws.com/eventsquid/   # Used by image upload + sponsor email template
# S3_PUBLIC_BUCKET=eventsquid
# S3_PRIVATE_BUCKET=eventsquid-private
# SENDGRID_SENDER=noreply@eventsquid.com                 # Default From address when sending email
# SMS_STATUS_CALLBACK_BASE_URL=                          # e.g. an ngrok URL — only needed for local Twilio status callback testing
# MONGO_DB_NAME=eventsquid                               # Mongo DB name override (default: eventsquid)
# ERROR_SNS_TOPIC_ARN=                                   # Set automatically by CloudFormation in Lambda environment
